# Vercel Postgres 연결 설정
# Vercel 대시보드에서 Postgres 생성 후 자동으로 설정됩니다.

# Pooled connection (serverless 환경용)
DATABASE_URL="postgres://..."

# Direct connection (마이그레이션용)
DIRECT_URL="postgres://..."

# 관리자 API 키 (DELETE /api/artworks/[id] 호출 시 Authorization: Bearer <키>)
# 비워두면 삭제 API는 항상 거부됩니다. 생성 예: openssl rand -hex 32
ADMIN_API_KEY=""

# 좋아요/댓글 제한용 IP 해시 솔트 (원본 IP는 저장하지 않음)
# 한 번 정한 뒤 바꾸면 기존 좋아요 기록과 매칭되지 않습니다. 생성 예: openssl rand -hex 32
IP_HASH_SALT=""

# Supabase Storage (작품 업로드 URL은 이 도메인의 artworks 버킷만 허용됨)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
