# Vercel Postgres 연결 설정
# Vercel 대시보드에서 Postgres 생성 후 자동으로 설정됩니다.

# Pooled connection (serverless 환경용)
DATABASE_URL="postgres://..."

# Direct connection (마이그레이션용)
DIRECT_URL="postgres://..."

# 관리자 API 키 (DELETE /api/artworks/[id] 호출 시 Authorization: Bearer <키>)
# 비워두면 삭제 API는 항상 거부됩니다. 생성 예: openssl rand -hex 32
ADMIN_API_KEY=""
