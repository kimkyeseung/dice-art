// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Artwork {
  id            String    @id @default(cuid())
  title         String
  authorName    String    // 하위 호환용 유지
  gridState     String    // JSON string
  // New URL-based fields (Supabase Storage)
  imageUrl      String?   // Supabase Storage URL (original, for download)
  thumbnailUrl  String?   // Supabase Storage URL (~150px, for gallery list)
  previewUrl    String?   // Supabase Storage URL (~900px, for detail page)
  // Legacy Base64 fields (for existing data)
  imageData     String?   // base64 encoded PNG
  thumbnailData String?   // base64 encoded PNG
  previewData   String?   // base64 encoded PNG
  width         Int
  height        Int
  likes         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  comments      Comment[]
  likeRecords   ArtworkLike[]

  @@index([createdAt])
}

// 좋아요 중복 방지 (작품당 IP 1회)
model ArtworkLike {
  id        String   @id @default(cuid())
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  ipHash    String   // SHA-256(salt + IP), 원본 IP는 저장하지 않음
  createdAt DateTime @default(now())

  @@unique([artworkId, ipHash])
}

model Comment {
  id         String   @id @default(cuid())
  content    String
  authorName String   // 하위 호환용 유지
  artworkId  String
  artwork    Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  ipHash     String?  // 작성 속도 제한용, 기존 댓글은 null
  createdAt  DateTime @default(now())

  @@index([artworkId])
  @@index([createdAt])
  @@index([ipHash, createdAt])
}
